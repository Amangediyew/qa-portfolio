        {
          "name": "API-005 POST Создание поста",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус-код 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Content-Type: application/json\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "const created = pm.response.json();",
                  "pm.test(\"Ответ содержит переданные данные\", function () {",
                  "  pm.expect(created.title).to.equal(\"QA test post\");",
                  "  pm.expect(created.body).to.equal(\"Created from Postman\");",
                  "  pm.expect(created.userId).to.equal(1);",
                  "});",
                  "pm.test(\"Серверный id присвоен (число)\", function () {",
                  "  pm.expect(created.id).to.be.a(\"number\");",
                  "});",
                  "pm.collectionVariables.set(\"createdPostId\", created.id);"
                ]
              }
            }
          ],
