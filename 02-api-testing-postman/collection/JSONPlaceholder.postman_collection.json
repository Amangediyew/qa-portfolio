                  "pm.test(\"Content-Type: application/json\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "pm.test(\"id в ответе равен запрошенному\", function () {",
                  "  pm.expect(pm.response.json().id).to.equal(Number(pm.variables.get(\"postId\")));",
                  "});",
                  "pm.test(\"Структура ответа соответствует схеме\", function () {",
                  "  pm.response.to.have.jsonSchema({\"type\": \"object\", \"required\": [\"userId\", \"id\", \"title\", \"body\"], \"properties\": {\"userId\": {\"type\": \"integer\"}, \"id\": {\"type\": \"integer\"}, \"title\": {\"type\": \"string\"}, \"body\": {\"type\": \"string\"}}});",
                  "});"
